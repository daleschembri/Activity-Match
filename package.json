{
  "name": "activity-match",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@activity-match/web",
    "dev:clean": "npm run dev:clean --workspace=@activity-match/web",
    "start": "npm run dev",
    "build": "npm run build --workspaces --if-present",
    "build:vercel": "npm run build --workspace=@activity-match/web && node scripts/prepare-vercel-output.mjs",
    "preview": "npm run preview --workspace=@activity-match/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "fetch:stitch": "node scripts/fetch-stitch-screens.mjs"
  },
  "devDependencies": {
    "@google/stitch-sdk": "^0.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
